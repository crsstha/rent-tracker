# Copy to `.env.local` and fill in as needed. Nothing here is required to run
# the app: with no .env at all it uses the local Dexie backend, which is the
# only backend implemented today.

# Which storage backend to resolve: dexie | firebase | hybrid
# `firebase` and `hybrid` are scaffolds — see FIREBASE_INTEGRATION.md. Setting
# either today logs a warning and falls back to dexie.
VITE_DATA_BACKEND=dexie

# ---------------------------------------------------------------------------
# Firebase — collected but unused until the Firestore adapter is finished.
# These are public client keys (they ship in the bundle); Firestore security
# rules, not secrecy, are what protect the data.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
