# Cloudflare Pages reads this file (it ignores netlify.toml / vercel.json).
#
# The service worker, shell and manifest must always revalidate, or a new
# deployment can't announce itself and the in-app "Update available" prompt
# never fires. Hashed assets are safe to cache forever.

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json

/assets/*
  Cache-Control: public, max-age=31536000, immutable
