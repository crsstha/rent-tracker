{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases — mirrored in vite.config.ts. Named after the reference
       client (togglecorp/ercs-client) so the two read the same way. */
    "paths": {
      "#views/*": ["./app/views/*"],
      "#components/*": ["./app/components/*"],
      "#hooks/*": ["./app/hooks/*"],
      "#utils/*": ["./app/utils/*"],
      "#lib/*": ["./app/lib/*"],
      "#store/*": ["./app/store/*"],
      "#root/*": ["./app/Root/*"],
      "#types": ["./app/types.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["app", "tests"]
}
