{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rent-tracker",
  // Pinned deliberately. Wrangler defaults this to "today" when it generates a
  // config during the build, which makes deploys non-reproducible.
  "compatibility_date": "2026-08-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    // `npm run build` (the Cloudflare build command) writes here.
    "directory": "./dist",
    // Serves index.html for any path that isn't a real file, so client-side
    // routes (/houses/:id, /settings/appearance, …) resolve instead of 404ing.
    // This is the SPA fallback — public/_redirects does not need to repeat it.
    "not_found_handling": "single-page-application"
  }
}
